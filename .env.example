# PostgreSQL connection string (Supabase is supported)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/security_km?schema=public"

# Required for signed employee sessions. Use a long random value in production.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Optional SMS notification through Twilio. Leave unset for local development.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
SMS_NOTIFY_TO=""
